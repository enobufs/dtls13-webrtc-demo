+// SetDTLSVersionRange sets the min/max DTLS version to negotiate. Pass
+// protocol.Version1_3 as max to negotiate DTLS 1.3; pion/dtls defaults an unset
+// range to 1.2, so 1.3 must be requested explicitly. A zero Version leaves that
+// bound unset.
+func (e *SettingEngine) SetDTLSVersionRange(minVersion, maxVersion protocol.Version) {
+	e.dtls.minVersion = minVersion
