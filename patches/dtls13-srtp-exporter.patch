+// TestExportKeyingMaterial13 verifies the DTLS 1.3 keying-material exporter
+// (RFC 8446 section 7.5 / RFC 9147). It drives a real pion<->pion 1.3 handshake
+// and asserts both peers export IDENTICAL EXTRACTOR-dtls_srtp material of the
+// requested length. Agreement across the pipe is the meaningful correctness
+// signal: a broken exporter (e.g. the old 1.2-PRF-over-empty-master-secret path)
+// would not produce matching keys on both ends.
+func TestExportKeyingMaterial13(t *testing.T) {
+	report := test.CheckRoutines(t)
+	defer report()
+
+	const exportLabel = "EXTRACTOR-dtls_srtp"
+	const exportLen = 60 // SRTP: 2*(16-byte key + 14-byte salt)
+
+	ca, cb := dpipe.Pipe()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+
+	type result struct {
+		c   *Conn
+		err error
 	}
+	resultCh := make(chan result, 1)
+	go func() {
+		client, err := testClient(ctx, dtlsnet.PacketConnFromConn(ca), ca.RemoteAddr(), []ClientOption{
+			WithSRTPProtectionProfiles(SRTP_AES128_CM_HMAC_SHA1_80),
+			WithMinVersion(protocol.Version1_3),
+			WithMaxVersion(protocol.Version1_3),
+		}, true)
+		resultCh <- result{client, err}
+	}()
+
+	server, err := testServer(ctx, dtlsnet.PacketConnFromConn(cb), cb.RemoteAddr(), []ServerOption{
+		WithSRTPProtectionProfiles(SRTP_AES128_CM_HMAC_SHA1_80),
+		WithMinVersion(protocol.Version1_3),
+		WithMaxVersion(protocol.Version1_3),
+	}, true)
+	assert.NoError(t, err, "server 1.3 handshake failed")
+	res := <-resultCh
+	assert.NoError(t, res.err, "client 1.3 handshake failed")
+	client := res.c
+	defer func() {
+		_ = client.Close()
+		_ = server.Close()
+	}()
+
+	clientState, ok := client.ConnectionState()
+	assert.True(t, ok)
+	serverState, ok := server.ConnectionState()
+	assert.True(t, ok)
+
+	// Precondition: this really is a 1.3 connection (else we'd test the 1.2 path).
+	assert.Equal(t, protocol.Version1_3, clientState.NegotiatedVersion(), "client not on DTLS 1.3")
+	assert.Equal(t, protocol.Version1_3, serverState.NegotiatedVersion(), "server not on DTLS 1.3")
+
+	clientKM, err := clientState.ExportKeyingMaterial(exportLabel, nil, exportLen)
+	assert.NoError(t, err, "client ExportKeyingMaterial (1.3)")
+	serverKM, err := serverState.ExportKeyingMaterial(exportLabel, nil, exportLen)
+	assert.NoError(t, err, "server ExportKeyingMaterial (1.3)")
+
+	assert.Len(t, clientKM, exportLen, "1.3 exporter returned wrong length")
+	assert.NotEqual(t, make([]byte, exportLen), clientKM, "1.3 exporter returned all-zero material")
+	// The exporter is role-independent in 1.3, so both peers MUST agree.
+	assert.Equal(t, clientKM, serverKM, "1.3 exporter disagreement between peers")
+
+	// A different label must produce different material.
+	otherKM, err := clientState.ExportKeyingMaterial("EXPORTER-other", nil, exportLen)
+	assert.NoError(t, err)
+	assert.NotEqual(t, clientKM, otherKM, "1.3 exporter ignored the label")
+
+	// Non-empty context is intentionally unsupported (matches the 1.2 path and
+	// WebRTC's DTLS-SRTP usage, which always passes an empty context).
+	_, err = clientState.ExportKeyingMaterial(exportLabel, []byte{0x00}, exportLen)
+	assert.ErrorIs(t, err, dtlserrors.ErrContextUnsupported, "1.3 exporter should reject non-empty context")
 }
