+// exportKeyingMaterial13 implements the TLS 1.3 exporter (RFC 8446 section 7.5),
+// used by DTLS 1.3 (RFC 9147). For an empty context it computes:
+//
+//	Derive-Secret(exporter_master_secret, label, "")             -> exporterSecret
+//	HKDF-Expand-Label(exporterSecret, "exporter", Hash(""), len) -> keying material
+//
+// HKDF-Expand-Label carries RFC 9147 section 5.9's "dtls13" prefix (applied by
+// the keyschedule package), matching DTLS 1.3 peers such as BoringSSL/Chrome.
+// Unlike the 1.2 PRF path, the exporter output does NOT depend on client/server
+// role or the ClientHello/ServerHello randoms.
+func (s *State) exportKeyingMaterial13(label string, context []byte, length int) ([]byte, error) {
+	if s.cipherSuiteDescriptor == nil || len(s.exporterMasterSecret) == 0 {
+		return nil, dtlserrors.ErrHandshakeInProgress
+	}
+	hashFunc := s.cipherSuiteDescriptor.HashFunc()
+
+	// Derive-Secret(Secret, Label, "") = HKDF-Expand-Label(Secret, Label, Hash(""), Hash.length).
+	// keyschedule.DeriveSecret hashes an empty transcript when passed nil.
+	exporterSecret, err := keyschedule.DeriveSecret(hashFunc, s.exporterMasterSecret, label, nil)
+	if err != nil {
+		return nil, err
+	}
+
+	// HKDF-Expand-Label(exporterSecret, "exporter", Hash(context), length).
+	h := hashFunc()
+	if _, err := h.Write(context); err != nil { // context is empty for DTLS-SRTP
+		return nil, err
+	}
+
+	return keyschedule.HkdfExpandLabel(hashFunc, exporterSecret, "exporter", h.Sum(nil), length)
+}
